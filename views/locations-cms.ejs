<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Locaties</title>
    <link rel="stylesheet" href="/style/style-cms.css" />
  </head>
  <body>
    <header>
      <img class="logo" src="/img/logo.svg" alt="" />
    </header>

    <div class="dashboard-wrapper">
      <div class="content-wrapper">
        <div>
          <div class="top">
            <h1>Locaties</h1>
            <input
              id="location-search"
              type="text"
              placeholder="Locatie zoeken"
              value="<%= search || '' %>"
            />
            <a class="btn" href="/cms/createlocation">Locatie aanmaken</a>
          </div>

          <table>
            <tbody id="locations-table-body">
              <% if (locations.length > 0) { %>
                <% locations.forEach((location, index) => { %>
                  <tr class="btn-position">
                    <td><%= index + 1 %></td>
                    <td><%= location.name %></td>
                    <td>
                      <% if (location.mapsLink) { %>
                        <a
                          class="address-link"
                          href="<%= location.mapsLink %>"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <%= location.address %>
                        </a>
                      <% } else { %>
                        <%= location.address %>
                      <% } %>
                    </td>
                    <td><%= location.city %></td>
                    <td><%= location.capacity %></td>
                    <td>
                      <a class="btn" href="/cms/locations/edit/<%= location._id %>">Locatie wijzigen</a>
                      <form action="/cms/locations/delete/<%= location._id %>" method="POST" style="display:inline;">
                        <button
                          class="btn"
                          type="submit"
                          onclick="return confirm('Weet je zeker dat je deze locatie wilt verwijderen?')"
                        >
                          Verwijderen
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6">Geen locaties gevonden.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <%- include('partials/sidebar-cms') %>
    </div>

    <script>
      const searchInput = document.getElementById("location-search");
      const tableBody = document.getElementById("locations-table-body");

      searchInput.addEventListener("input", async function () {
        const searchValue = searchInput.value;

        try {
          const response = await fetch(`/cms/locations/search/ajax?search=${encodeURIComponent(searchValue)}`);
          const locations = await response.json();

          if (!locations.length) {
            tableBody.innerHTML = `
              <tr>
                <td colspan="6">Geen locaties gevonden.</td>
              </tr>
            `;
            return;
          }

          tableBody.innerHTML = locations.map((location, index) => `
            <tr class="btn-position">
              <td>${index + 1}</td>
              <td>${location.name}</td>
              <td>
                ${
                  location.mapsLink
                    ? `<a
                        class="address-link"
                        href="${location.mapsLink}"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        ${location.address}
                      </a>`
                    : `${location.address}`
                }
              </td>
              <td>${location.city}</td>
              <td>${location.capacity}</td>
              <td>
                <a class="btn" href="/cms/locations/edit/${location._id}">Locatie wijzigen</a>
                <form action="/cms/locations/delete/${location._id}" method="POST" style="display:inline;">
                  <button
                    class="btn"
                    type="submit"
                    onclick="return confirm('Weet je zeker dat je deze locatie wilt verwijderen?')"
                  >
                    Verwijderen
                  </button>
                </form>
              </td>
            </tr>
          `).join("");
        } catch (error) {
          console.error("Fout bij live zoeken:", error);
        }
      });
    </script>
  </body>
</html>