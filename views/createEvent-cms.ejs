<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= editMode ? "Event aanpassen" : "Event aanmaken" %></title>
    <link rel="stylesheet" href="/style/style-cms.css" />
    <link rel="stylesheet" href="/style/create.css">
</head>

<body>
    <header>
        <img class="logo" src="/img/logo.svg" alt="">
    </header>

    <div class="dashboard-wrapper">
        <div class="content-wrapper">
            <div>
                <div class="top">
                    <h1><%= editMode ? "Event aanpassen" : "Evenement aanmaken" %></h1>
                </div>

                <form action="<%= editMode ? '/cms/events/edit/' + event._id : '/cms/events/create' %>" 
                      method="POST" enctype="multipart/form-data">

                    <div class="lft-clm">
                        <div>
                            <label for="title">Titel:</label>
                            <input name="title" type="text" id="title" value="<%= event ? event.title : '' %>" required>
                        </div>

                        <!-- LOCATIE SELECT -->
                        <div>
                            <label for="location">Locatie:</label>
                            <select name="location" id="location" required>
                                <option value="">Kies een locatie</option>

                                <% locations.forEach(loc => { %>
                                    <option value="<%= loc._id %>"
                                        <%= event && event.location == loc._id.toString() ? "selected" : "" %>>
                                        <%= loc.name %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <!-- LINEUP -->
                        <div class="lineup-wrapper">
                            <label>Lineup:</label>

                            <div class="lineup-input">
                                <input type="text" id="lineupInput" placeholder="Artiest toevoegen">
                                <button class="btn" type="button" id="addLineupBtn">add</button>
                            </div>

                            <ul id="lineupList">
                                <% if (event && event.lineup) { %>
                                    <% event.lineup.forEach((artist) => { %>
                                        <li class="lineup-name">
                                            <span><%= artist %></span>
                                            <button type="button" class="removeLineup">x</button>
                                        </li>
                                    <% }) %>
                                <% } %>
                            </ul>

                            <input type="hidden" name="lineup" id="lineupHidden"
                                value="<%= event && event.lineup ? event.lineup.join(',') : '' %>">
                        </div>
                    </div>

                    <div class="rgt-clm">
                        <div>
                            <label for="date">Datum:</label>
                            <input name="date" type="date" id="date"
                                value="<%= event && event.date ? event.date.toISOString().split('T')[0] : '' %>"
                                required>
                        </div>

                        <div>
                            <label for="eventLink">Event link:</label>
                            <input name="eventLink" type="text" id="eventLink"
                                value="<%= event ? event.eventLink : '' %>">
                        </div>

                        <!-- KLEINE AFBEELDING -->
                        <div>
                            <label>Kleine afbeelding:</label>
                            <input type="file" name="imageSmall" accept="image/*">

                            <% if (event && event.imageSmall) { %>
                                <img src="/uploads/events/<%= event.imageSmall %>" width="120">
                            <% } %>
                        </div>

                        <!-- GROTE AFBEELDING -->
                        <div>
                            <label>Grote afbeelding:</label>
                            <input type="file" name="imageLarge" accept="image/*">

                            <% if (event && event.imageLarge) { %>
                                <img src="/uploads/events/<%= event.imageLarge %>" width="200">
                            <% } %>
                        </div>

                        <div>
                            <p>Event aangemaakt:</p>
                            <p><%= event && event.createdAt ? event.createdAt.toLocaleString() : "Nieuw event" %></p>
                        </div>

                        <!-- STATUS KNOPPEN -->
                        <div class="status-buttons">
                            <button class="btn" name="status" value="concept" type="submit">Opslaan als concept</button>
                            <button class="btn" name="status" value="gepubliceerd" type="submit">Publiceren</button>
                        </div>

                    </div>

                </form>
            </div>
        </div>

        <%- include('partials/sidebar-cms') %>
    </div>

    <script>
        // Haal de input, knop, lijst en hidden input op uit de DOM
        const input = document.getElementById("lineupInput");
        const addBtn = document.getElementById("addLineupBtn");
        const list = document.getElementById("lineupList");
        const hidden = document.getElementById("lineupHidden");

        // Functie om de hidden input te updaten met alle namen uit de lijst
        function updateHidden() {
            const items = [...list.querySelectorAll("li span")].map(span => span.textContent.trim());
            hidden.value = items.join(",");
        }

        // Event listener voor de add knop
        addBtn.addEventListener("click", () => {
            if (!input.value.trim()) return;

            // Maak een nieuwe list item aan met de ingevoerde naam en een verwijderknop
            const li = document.createElement("li");
            li.classList.add("lineup-name");
            li.innerHTML = `<span>${input.value}</span> <button type="button" class="removeLineup">x</button>`;
            list.appendChild(li);

            // Maak de input leeg en update de hidden input
            input.value = "";
            updateHidden();
        });

        // Event listener voor de lijst om te luisteren naar clicks op de verwijderknoppen
        list.addEventListener("click", (e) => {
            if (e.target.classList.contains("removeLineup")) {
                e.target.parentElement.remove();
                updateHidden();
            }
        });
    </script>

</body>

</html>
