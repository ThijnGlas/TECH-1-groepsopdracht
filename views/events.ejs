<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="./style/style.css" />
    <link rel="stylesheet" href="./style/events.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
  </head>

  <body>
    <%- include('partials/header') %>
    <main>
      <section>
        <div class="top-main">
          <h1>Events</h1>
          <form method="GET" action="/events">
            <div>
              <select name="location" id="locatie" onchange="this.form.submit()">
                <option value="All" <%= selectedLocation === "All" ? "selected" : "" %>>All locations</option>

                <% cities.forEach(city => { %>
                  <option value="<%= city %>" <%= selectedLocation === city ? "selected" : "" %>>
                    <%= city %>
                  </option>
                <% }) %>
              </select>

              <select name="month" onchange="this.form.submit()">
                  <option value="All" <%= selectedMonth === "All" ? "selected" : "" %>>
                    All months
                  </option>

                  <option value="7" <%= selectedMonth === "7" ? "selected" : "" %>>
                    July
                  </option>

                  <option value="8" <%= selectedMonth === "8" ? "selected" : "" %>>
                    August
                  </option>

                  <option value="9" <%= selectedMonth === "9" ? "selected" : "" %>>
                    September
                  </option>
              </select>

            </div>
          </form>
        </div>
        <div class="event-wrapper">
          <% events.forEach(event => { %>
            <article class="event" onclick="location.href='/event/<%= event._id %>'">
              <img src="/uploads/events/<%= event.imageSmall %>" alt="<%= event.title %>" />
        
              <div>
                <div class="event-naam">
                  <h2><%= event.title %></h2>
        
                  <div class="event-beschrijving">
                    <p><%= event.locationData.name %></p>
                    <p>
                      <%= new Date(event.date).toLocaleDateString("en-US", {
                        day: "numeric",
                        month: "long",
                        year: "numeric"
                      }) %>
                    </p>
                  </div>
                </div>
        
                <a class="btn" href="<%= event.eventLink %>">
                  Tickets <img src="/img/arrow.svg" alt="arrow" />
                </a>
              </div>
            </article>
          <% }) %>
        </div>
      </section>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>