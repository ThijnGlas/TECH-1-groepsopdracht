<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="./style/style.css" />
    <link rel="stylesheet" href="./style/events.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
  </head>

  <body>
    <%- include('partials/header') %>
    <main>
      <section>
        <div class="top-main">
          <h1>Events</h1>
          <div>
            <select name="locatie" id="locatie">
              <option value="" disabled selected>Location</option>
              <option value="All">All</option>
              <option value="Amsterdam">Amsterdam</option>
              <option value="Haarlem">Haarlem</option>
              <option value="Utrecht">Utrecht</option>
              <option value="Castricum">Castricum</option>
            </select>
            <select name="Datum" id="Datum">
              <option value="" disabled selected>Date</option>
              <option value="All">All</option>
              <option value="Juli">July</option>
              <option value="Augustus">August</option>
              <option value="September">September</option>
            </select>
          </div>
        </div>
        <div class="event-wrapper">
          <% events.forEach(event => { %>
            <article class="event" onclick="location.href='/event/<%= event._id %>'">
              <img src="/uploads/events/<%= event.imageSmall %>" alt="<%= event.title %>" />
        
              <div>
                <div class="event-naam">
                  <h2><%= event.title %></h2>
        
                  <div class="event-beschrijving">
                    <p><%= event.locationData.name %></p>
                    <p>
                      <%= new Date(event.date).toLocaleDateString("en-US", {
                        day: "numeric",
                        month: "long",
                        year: "numeric"
                      }) %>
                    </p>
                  </div>
                </div>
        
                <a class="btn" href="<%= event.eventLink %>">
                  Tickets <img src="/img/arrow.svg" alt="arrow" />
                </a>
              </div>
            </article>
          <% }) %>
        </div>
      </section>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>