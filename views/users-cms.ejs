<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="../style/style-cms.css" />
  </head>
  <body>
    <header>
      <img class="logo" src="../img/logo.svg" alt="" />
    </header>
    <div class="dashboard-wrapper">
      <div class="content-wrapper">
        <div>
          <div class="top">
            <h1>Gebruikers</h1>
            <form action="">
              <input type="text" name="search" placeholder="Gebruiker zoeken" />
            </form>
            <a class="btn" href="/cms/createuser">Gebruiker aanmaken</a>
          </div>
          <table>
            <% users.forEach((user, index) => { %>
              <tr class="btn-position">
                <td><%= index + 1 %></td>
                <td><%= user.username %></td>
                <td><%= user.email %></td>
                <td><%= user.role || 'Geen rol' %></td>
                <td>
                  <a class="btn" href="/cms/users/edit/<%= user._id %>">Gebruiker wijzigen</a>
                  <form action="/cms/users/delete/<%= user._id %>" method="POST" style="display:inline;">
                    <button class="btn" type="submit" onclick="return confirm('Weet je zeker dat je deze gebruiker wilt verwijderen?')">Verwijderen</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </table>
        </div>
      </div>
      <%- include('partials/header-cms') %>
    </div>
  </body>
</html>
