<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Artiesten</title>
  <link rel="stylesheet" href="../style/style-cms.css" />
</head>

<body>
  <%- include('partials/header-cms') %>

  <div class="dashboard-wrapper">
    <div class="content-wrapper">
      <div>
        <div class="top">
          <h1>Artiesten</h1>

          <input
            id="artist-search"
            type="text"
            placeholder="Artiest zoeken"
            value="<%= search || '' %>"
          />

          <a class="btn" href="/cms/createartist">Artiest aanmaken</a>
        </div>

        <table>
          <tbody id="artists-table-body">
            <% if (artists.length > 0) { %>
              <% artists.forEach((artist, index) => { %>
                <tr class="btn-position">
                  <td><%= index + 1 %></td>
                  <td><%= artist.name %></td>
                  <td>
                    <a class="btn" href="/cms/artists/edit/<%= artist._id %>">Artiest wijzigen</a>

                    <form action="/cms/artists/delete/<%= artist._id %>" method="POST" style="display:inline;">
                      <button
                        class="btn"
                        type="submit"
                        onclick="return confirm('Weet je zeker dat je deze gebruiker wilt verwijderen?')"
                      >
                        Verwijderen
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="3">Geen artiesten gevonden.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <%- include('partials/sidebar-cms') %>
  </div>

  <script>
    const searchInput = document.getElementById("artist-search");
    const tableBody = document.getElementById("artists-table-body");

    searchInput.addEventListener("input", async function () {
      const searchValue = searchInput.value;

      try {
        const response = await fetch(`/cms/artists/search/ajax?search=${encodeURIComponent(searchValue)}`);
        const artists = await response.json();

        if (!artists.length) {
          tableBody.innerHTML = `
            <tr>
              <td colspan="3">Geen artiesten gevonden.</td>
            </tr>
          `;
          return;
        }

        tableBody.innerHTML = artists.map((artist, index) => `
          <tr class="btn-position">
            <td>${index + 1}</td>
            <td>${artist.name}</td>
            <td>
              <a class="btn" href="/cms/artists/edit/${artist._id}">Artiest wijzigen</a>

              <form action="/cms/artists/delete/${artist._id}" method="POST" style="display:inline;">
                <button
                  class="btn"
                  type="submit"
                  onclick="return confirm('Weet je zeker dat je deze gebruiker wilt verwijderen?')"
                >
                  Verwijderen
                </button>
              </form>
            </td>
          </tr>
        `).join("");
      } catch (error) {
        console.error("Fout bij live zoeken:", error);
      }
    });
  </script>
</body>
</html>