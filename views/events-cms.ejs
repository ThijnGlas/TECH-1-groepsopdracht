<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Events</title>
  <link rel="stylesheet" href="/style/style-cms.css" />
</head>

        <!-- Zoekbalk voor live search in het CMS.
             De huidige zoekterm blijft zichtbaar door de waarde uit de backend opnieuw in te vullen. -->
            <input
              id="event-search"
              type="text"
              placeholder="Evenement zoeken"
              value="<%= search || '' %>"
            />
<body>
  <header>
    <img class="logo" src="/img/logo.svg" alt="" />
  </header>

  <div class="dashboard-wrapper">
    <div class="content-wrapper">
      <div>
        <div class="top">
          <h1>Events</h1>

          <table>
            <!-- Deze tbody bevat de rijen van de eventtabel.
                 Wanneer de pagina voor het eerst laadt, vult EJS deze met de events
                 die vanuit de backend zijn meegegeven via res.render().
                 Daarna gebruikt JavaScript dezelfde tbody om de zoekresultaten live
                 te vervangen zonder dat de pagina opnieuw moet laden. -->
            <tbody id="events-table-body">
              <% if (events.length > 0) { %>
                <% events.forEach((event, index) => { %>
                  <tr class="btn-position">
                    <td><%= index + 1 %></td>
                    <td><%= event.title %></td>
                    <!-- Datum formatteren zodat die leesbaar wordt weergegeven in de tabel -->
                    <td><%= new Date(event.date).toLocaleDateString('nl-NL') %></td>
                    <!-- locationData.name komt uit de $lookup in de backend-route -->
                    <td><%= event.locationData ? event.locationData.name : 'Geen locatie' %></td>
                    <td><%= event.status || 'Geen status' %></td>
                    <td>
                      <a class="btn" href="/cms/events/edit/<%= event._id %>">Evenement wijzigen</a>
                      <form action="/cms/events/delete/<%= event._id %>" method="POST" style="display:inline;">
                        <button class="btn" type="submit" onclick="return confirm('Weet je zeker dat je dit evenement wilt verwijderen?')">
                          Verwijderen
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6">Geen evenementen gevonden.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
          <input id="event-search" type="text" placeholder="Evenement zoeken" value="<%= search || '' %>" />

          <a class="btn" href="/cms/createevent">Evenement aanmaken</a>
        </div>

        <table>
          <tbody id="events-table-body">
            <% if (events.length> 0) { %>
              <% events.forEach((event, index)=> { %>
                <tr class="btn-position">
                  <td>
                    <%= index + 1 %>
                  </td>
                  <td>
                    <%= event.title %>
                  </td>
                  <td>
                    <%= new Date(event.date).toLocaleDateString('nl-NL') %>
                  </td>
                  <td>
                    <%= event.locationData ? event.locationData.name : 'Geen locatie' %>
                  </td>
                  <td>
                    <%= event.status || 'Geen status' %>
                  </td>
                  <td>
                    <a class="btn" href="/cms/events/edit/<%= event._id %>">Evenement wijzigen</a>
                    <form action="/cms/events/delete/<%= event._id %>" method="POST" style="display:inline;">
                      <button class="btn" type="submit"
                        onclick="return confirm('Weet je zeker dat je dit evenement wilt verwijderen?')">
                        Verwijderen
                      </button>
                    </form>
                  </td>
                </tr>
                <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="6">Geen evenementen gevonden.</td>
                    </tr>
                    <% } %>
          </tbody>
        </table>
      </div>
    </div>
    <%- include('partials/sidebar-cms') %>
  </div>

    <!-- Dit script bevat de AJAX-logica voor live search in het CMS -->
    <script>
      const searchInput = document.getElementById("event-search");
      const tableBody = document.getElementById("events-table-body");

    // voeg een event listener toe aan de input voor het live zoeken
    searchInput.addEventListener("input", async function () {
      const searchValue = searchInput.value;

      try {
        // maak een fetch request naar de server met de zoekterm 
        const response = await fetch(`/cms/events/search/ajax?search=${encodeURIComponent(searchValue)}`);
        const events = await response.json();

        // als er geen events gevonden worden, toon een bericht in de tabel
        if (!events.length) {
          tableBody.innerHTML = `
              <tr>
                <td colspan="6">Geen evenementen gevonden.</td>
              </tr>
            `;
          return;
        }

        // update de tabel met de gevonden gebruikers
        tableBody.innerHTML = events.map((event, index) => `
            <tr class="btn-position">
              <td>${index + 1}</td>
              <td>${event.title}</td>
              <td>${new Date(event.date).toLocaleDateString('nl-NL')}</td>
              <td>${event.locationData ? event.locationData.name : 'Geen locatie'}</td>
              <td>${event.status || 'Geen status'}</td>
              <td>
                <a class="btn" href="/cms/events/edit/${event._id}">Evenement wijzigen</a>
                <form action="/cms/events/delete/${event._id}" method="POST" style="display:inline;">
                  <button class="btn" type="submit" onclick="return confirm('Weet je zeker dat je dit evenement wilt verwijderen?')">
                    Verwijderen
                  </button>
                </form>
              </td>
            </tr>
          `).join("");
        } catch (error) {
          console.error("Fout bij live zoeken events:", error);
        }
      });
    </script>
  </body>
</html>
