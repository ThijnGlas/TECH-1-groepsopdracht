<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Locatie aanpassen</title>
    <link rel="stylesheet" href="/style/style-cms.css" />
    <link rel="stylesheet" href="/style/create.css">
</head>

<body>
    <header>
        <img class="logo" src="/img/logo.svg" alt="">
    </header>
    <div class="dashboard-wrapper">
        <div class="content-wrapper">
            <div>
                <div class="top">
                    <h1>Locatie aanpassen</h1>
                </div>

                <form action="/cms/locations/edit/<%= location._id %>" method="POST">
                    <div class="lft-clm">
                        <div>
                            <label for="name">Naam locatie:</label>
                            <input name="name" type="text" id="name" value="<%= location.name %>" required>
                        </div>

                        <div>
                            <label for="address">Adres:</label>
                            <input name="address" type="text" id="address" value="<%= location.address %>" required>
                        </div>

                        <!-- 🔥 NIEUW -->
                        <div>
                            <label for="mapsLink">Maps link:</label>
                            <input 
                                name="mapsLink" 
                                type="text" 
                                id="mapsLink" 
                                value="<%= location.mapsLink || '' %>" 
                                placeholder="https://maps.google.com/..." 
                            >
                        </div>
                    </div>

                    <div class="rgt-clm">
                        <div>
                            <label for="city">Stad:</label>
                            <input name="city" type="text" id="city" value="<%= location.city %>" required>
                        </div>

                        <div>
                            <label for="capacity">Capaciteit:</label>
                            <input name="capacity" type="number" id="capacity" value="<%= location.capacity %>" required>
                        </div>
                    </div>

                    <input class="btn" type="submit" value="Locatie opslaan">
                </form>
            </div>
        </div>

        <%- include('partials/sidebar-cms') %>
    </div>
</body>

</html>