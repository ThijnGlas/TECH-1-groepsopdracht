<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Artiest wijzigen</title>
    <link rel="stylesheet" href="/style/style-cms.css" />
    <link rel="stylesheet" href="/style/editArtist.css">
</head>

<body>
    <%- include('partials/header-cms') %>
    <div class="dashboard-wrapper">
        <div class="content-wrapper">
            <div>
                <div class="top">
                    <h1>Artiest wijzigen</h1>
                    <a class="btn" href="/cms/artists">Terug naar overzicht</a>
                </div>
                <form action="/cms/artists/edit/<%= artist._id %>" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label for="name">Naam</label>
                        <input type="text" id="name" name="name" value="<%= artist.name %>" required />
                    </div>
                    <div class="form-group">
                        <label for="photo">Foto (optioneel, laat leeg om huidige te behouden)</label>
                        <input type="file" id="photo" name="photo" accept="image/*" />
                    </div>
                    <button class="btn" type="submit">Opslaan</button>
                </form>
            </div>
        </div>
        <%- include('partials/sidebar-cms') %>
    </div>
</body>

</html>