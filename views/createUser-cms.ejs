<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style/style-cms.css" />
    <link rel="stylesheet" href="/style/create.css">
</head>

<body>
    <%- include('partials/header-cms') %>
    <div class="dashboard-wrapper">
        <div class="content-wrapper">
            <div>
                <div class="top">
                    <h1>
                        <%= editMode ? "Gebruiker aanpassen" : "Nieuwe gebruiker aanmaken" %>
                    </h1>
                </div>
                <form action="<%= editMode ? '/cms/users/edit/' + user._id : '/cms/users/create' %>" method="POST">
                    <div class="lft-clm">
                        <div>
                            <label for="naam">Gebruikersnaam:</label>
                            <input name="username" type="text" id="naam" value="<%= user ? user.username : '' %>"
                                required>
                        </div>
                        <div>
                            <label for="mail">Email:</label>
                            <input name="email" type="email" id="mail" value="<%= user ? user.email : '' %>" required>
                        </div>
                        <input class="btn" type="submit" value="<%= editMode ? 'Opslaan' : 'Gebruiker opslaan' %>">

                    </div>
                    <div class="rgt-clm">
                        <div>
                            <label for="password">Wachtwoord:</label>
                            <input name="password" type="password" id="password" <%=editMode ? '' : 'required' %>
                            placeholder="<%= editMode ? 'Laat leeg als je niets wilt veranderen' : '' %>"
                                >
                        </div>
                        <div class="info">
                            <div>
                                <p>Gebruiker aangemaakt:</p>
                                <p>
                                    <%= user && user.createdAt ? user.createdAt.toLocaleString() : '...' %>
                                </p>
                            </div>
                            <div>
                                <p>Laatste keer gezien:</p>
                                <p>
                                    <%= user && user.lastSeen ? user.lastSeen.toLocaleString() : '...' %>
                                </p>
                            </div>
                        </div>
                        
                    </div>
                </form>
            </div>
        </div>
        <%- include('partials/sidebar-cms') %>

    </div>
</body>

</html>