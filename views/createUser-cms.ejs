<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../style/style-cms.css" />
    <link rel="stylesheet" href="../style/createUser.css">
</head>
<body>
    <header>
        <img class="logo" src="../img/logo.svg" alt="">
    </header>
    <div class="dashboard-wrapper">
        <div class="content-wrapper">
            <div>
                <div class="top">
                    <h1>Gebruiker aanpassen</h1>
                </div>
                <form action="/cms/createuser" method="POST">
                    <div class="lft-clm">
                        <div>
                            <label for="naam">Gebruikersnaam:</label>
                            <input name="username" type="text" id="naam" required>
                        </div>
                        <div>
                            <label for="mail">Email:</label>
                            <input name="email" type="email" id="mail" required>
                        </div> 
                    </div>
                    <div class="rgt-clm">
                        <div>
                            <label for="password">Wachtwoord:</label>
                            <input name="password" type="password" id="password" required>
                        </div>
                        <div class="info">
                            <div>
                                <p>Gebruiker aangemaakt:</p>
                                <p>...</p>
                            </div>
                            <div>
                                <p>Laatste keer gezien:</p>
                                <p>...</p>
                            </div>
                        </div>
                        
                    </div>
                    
                    <input class="btn" type="submit" value="Gebruiker opslaan">
                </form>
            </div>    
            </div>
             <div>
            <nav class="menu" id="menu">
                <ul>
                  <li><a href="/dashboard">Dashboard</a></li>
                  <li><a href="/gebruikers">Gebruikers</a></li>
                  <li><a href="/events">Events</a></li>
                  <li><a href="/tickets">Tickets</a></li>
                  <li><a href="/locaties">Locaties</a></li>
                </ul>
                <a href="">Uitloggen</a>
              </nav>
        </div>
    </div>
</body>
</html>