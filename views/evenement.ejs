<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="../style/style.css">
    <link rel="stylesheet" href="../style/evenement.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <title>Document</title>
  </head>
  <body>
    <%- include('partials/header') %>
    <main>
      <section>
        <div class="buttons-naast-elklaar">
          <a href="/events" class="btn-evenementen1"><img src="../img/arrow.svg" alt="arrow"> Back to events overview</a>
          <a href="<%= event.eventLink %>" class="btn-evenementen2">
            Get tickets <img src="../img/arrow.svg" alt="arrow">
          </a>
        </div>
        <article class="event-card">
          <div class="event-content">
            <h1><%= event.title %></h1>
            <div class="event-info">
              <a href="<%= event.locationData.addresslink %>"><%= event.locationData.address %></a>
              <p>
                <%= new Date(event.date).toLocaleDateString("en-US", {
                  day: "numeric",
                  month: "long",
                  year: "numeric"
                }) %>
              </p>
            
             
            </div>
            <div class="line-up">
              <% event.lineup.forEach(item => { %>
                <p><%= item %></p>
              <% }) %>
            </div>            
          </div>

          <div class="event-image-wrapper">
            <img src="/uploads/events/<%= event.imageLarge %>" alt="<%= event.title %>">
          </div>
          
        </article>
      </section>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
